#include <Arduino.h>
#include <Wire.h>
#include <HX711.h>
#include <TinyGPSPlus.h>
#include <Adafruit_MPU6050.h>
#include <Adafruit_Sensor.h>
#include <Adafruit_INA219.h>
#include <DS1302.h>
#include <math.h>
#include <WiFi.h>
#include <HTTPClient.h>

/* ========= PIN ========= */
#define LED_GREEN 26
#define LED_RED   2
#define BUZZER_PIN 13
#define LDR_PIN 34

#define HX_DT 32
#define HX_SCK 33

#define IN1 25
#define IN2 27
#define IN3 14
#define IN4 12

// Conveyor DC motor via modul ULN: ESP32 pin -> ULN IN, motor -> V+ dan ULN OUT.
#define CONVEYOR_ULN_PIN IN1

#define RXD_RASPI 16
#define TXD_RASPI 17
#define RASPI_BAUD 9600
#define USB_BAUD 115200

#define RXD_GPS 5
#define TXD_GPS 15

#define RTC_CLK 18
#define RTC_DAT 19
#define RTC_RST 23


/* ========= OBJECT ========= */
HX711 scale;
TinyGPSPlus gps;
Adafruit_MPU6050 mpu;
Adafruit_INA219 ina219;
DS1302 rtc(RTC_RST, RTC_DAT, RTC_CLK);


/* ========= VAR ========= */
bool conveyor_on = false;
String raspiCommand = "";

unsigned long lastBlink = 0;
bool redState = false;

unsigned long lastHome = 0;
float berat = 0;
float tilt = 0;
float volt = 0;
int ldr = 0;

// Sensor health monitoring
bool mpuHealthy = false;
bool ina219Healthy = false;
bool scaleHealthy = false;
bool gpsHealthy = false;

/* ========= WIFI & SERVER ========= */
// Ganti dengan SSID dan password WiFi Anda
const char* ssid = "YOUR_WIFI_SSID";
const char* password = "YOUR_WIFI_PASSWORD";

// URL server (ganti dengan IP Raspberry Pi Anda)
const char* serverUrl = "http://192.168.1.10:5000";

unsigned long lastServerUpdate = 0;
bool serverConnected = false;

// Timeout dan retry settings
const int HTTP_TIMEOUT = 5000;  // 5 detik timeout
const int SERVER_RETRY_DELAY = 30000;  // 30 detik retry jika gagal
const int WIFI_RETRY_DELAY = 10000;  // 10 detik retry WiFi
unsigned long lastServerRetry = 0;
unsigned long lastWiFiRetry = 0;


/* ========= PROTOTYPES ========= */
void readSensors();
void motorControl();
void stopMotor();
void indicateStatus();
void sendData();
void checkHome();
void beep(int x);
void connectWiFi();
void checkWiFiConnection();
void sendToServer();
void checkServerControl();
void handleRaspiUART();
void processRaspiCommand(String cmd);
void setConveyor(bool on, const char* source);
void sendConveyorStatus(const char* source);

/* ========= SETUP ========= */
void setup() {

Serial.begin(USB_BAUD);

/* Serial ke Raspi */
Serial2.begin(RASPI_BAUD, SERIAL_8N1, RXD_RASPI, TXD_RASPI);

/* GPS */
Serial1.begin(9600, SERIAL_8N1, RXD_GPS, TXD_GPS);

/* IO */
pinMode(LED_GREEN, OUTPUT);
pinMode(LED_RED, OUTPUT);
pinMode(BUZZER_PIN, OUTPUT);

pinMode(IN1, OUTPUT);
pinMode(IN2, OUTPUT);
pinMode(IN3, OUTPUT);
pinMode(IN4, OUTPUT);

/* HX711 */
scale.begin(HX_DT, HX_SCK);
scale.set_scale(-7050); // kalibrasi sesuaikan
scale.tare();
scaleHealthy = true;

/* I2C */
Wire.begin(21, 22);

/* Sensor - dengan health check */
if (mpu.begin()) {
  mpuHealthy = true;
  Serial.println("MPU6050 OK");
} else {
  Serial.println("MPU6050 ERROR");
}

if (ina219.begin()) {
  ina219Healthy = true;
  Serial.println("INA219 OK");
} else {
  Serial.println("INA219 ERROR");
}

/* RTC */
rtc.halt(false);
rtc.writeProtect(false);

stopMotor();

/* WiFi */
connectWiFi();

Serial.println("=== SMART RIVER START ===");
beep(2);
}


/* ========= LOOP ========= */
void loop() {
  checkWiFiConnection();

  readSensors();
  handleRaspiUART();
  motorControl();
  sendData();
  checkHome();

  // Komunikasi dengan server setiap 5 detik
  if (millis() - lastServerUpdate > 5000) {
    lastServerUpdate = millis();
    sendToServer();
  }

  // Indikator status LED
  indicateStatus();

  delay(200);
}


/* ========= SENSOR ========= */
void readSensors() {
  // Baca berat (HX711)
  float rawBerat = scale.get_units(5) * 1000;
  if (rawBerat > -100 && rawBerat < 100000) {  // Validasi range
    berat = rawBerat;
    scaleHealthy = true;
  } else {
    scaleHealthy = false;
    Serial.println("HX711 reading invalid, keeping last value");
  }
  
  // Baca LDR
  ldr = analogRead(LDR_PIN);

  // Baca MPU6050 dengan error handling
  sensors_event_t a, g, temp;
  if (mpu.getEvent(&a, &g, &temp)) {
    tilt = atan2(a.acceleration.y, a.acceleration.z) * 180 / PI;
    mpuHealthy = true;
  } else {
    Serial.println("MPU ERROR - using last tilt value");
    mpuHealthy = false;
  }

  // Baca voltage dengan error handling
  float rawVolt = ina219.getBusVoltage_V();
  if (rawVolt > 0 && rawVolt < 25) {  // Validasi range voltage
    volt = rawVolt;
    ina219Healthy = true;
  } else {
    Serial.println("INA219 reading invalid");
    ina219Healthy = false;
  }

  // Decode GPS
  int gpsValidCount = 0;
  while (Serial1.available()) {
    if (gps.encode(Serial1.read())) {
      gpsValidCount++;
    }
  }
  gpsHealthy = gps.location.isValid();
}


/* ========= KONTROL DARI RASPI ========= */
/* ========= UART DARI RASPI ========= */
void handleRaspiUART() {
  while (Serial2.available()) {
    char c = (char)Serial2.read();

    if (c == '\n' || c == '\r') {
      if (raspiCommand.length() > 0) {
        processRaspiCommand(raspiCommand);
        raspiCommand = "";
      }
      continue;
    }

    if (raspiCommand.length() < 80) {
      raspiCommand += c;
    } else {
      raspiCommand = "";
      Serial.println("UART command terlalu panjang, dibuang");
      Serial2.println("{\"type\":\"ack\",\"ok\":false,\"error\":\"command_too_long\"}");
    }
  }
}

void processRaspiCommand(String cmd) {
  cmd.trim();
  cmd.toUpperCase();

  if (cmd == "CONVEYOR_ON" || cmd == "CONVEYOR ON" || cmd == "C1" ||
      cmd.indexOf("\"CONVEYOR\":TRUE") >= 0 || cmd.indexOf("\"CONVEYOR\":1") >= 0 ||
      cmd.indexOf("\"CMD\":\"CONVEYOR_ON\"") >= 0) {
    setConveyor(true, "uart");
    sendConveyorStatus("uart");
    return;
  }

  if (cmd == "CONVEYOR_OFF" || cmd == "CONVEYOR OFF" || cmd == "OFF" || cmd == "C0" ||
      cmd.indexOf("\"CONVEYOR\":FALSE") >= 0 || cmd.indexOf("\"CONVEYOR\":0") >= 0 ||
      cmd.indexOf("\"CMD\":\"CONVEYOR_OFF\"") >= 0) {
    setConveyor(false, "uart");
    sendConveyorStatus("uart");
    return;
  }

  if (cmd == "TOGGLE" || cmd == "CONVEYOR_TOGGLE" || cmd == "CT") {
    setConveyor(!conveyor_on, "uart");
    sendConveyorStatus("uart");
    return;
  }

  if (cmd == "STATUS" || cmd == "?" || cmd == "PING") {
    sendConveyorStatus("uart");
    return;
  }

  Serial.print("Perintah UART tidak dikenal: ");
  Serial.println(cmd);
  Serial2.println("{\"type\":\"ack\",\"ok\":false,\"error\":\"unknown_command\"}");
}

void setConveyor(bool on, const char* source) {
  conveyor_on = on;
  digitalWrite(CONVEYOR_ULN_PIN, conveyor_on ? HIGH : LOW);

  Serial.print("CONVEYOR ");
  Serial.print(conveyor_on ? "ON" : "OFF");
  Serial.print(" dari ");
  Serial.println(source);
}

void sendConveyorStatus(const char* source) {
  Serial2.print("{\"type\":\"ack\",\"ok\":true,\"source\":\"");
  Serial2.print(source);
  Serial2.print("\",\"conveyor\":");
  Serial2.print(conveyor_on ? "true" : "false");
  Serial2.println("}");
}

/* ========= LED ========= */
void blinkLED() {
  // Blink merah setiap 5 detik
  if (millis() - lastBlink > 5000) {
    lastBlink = millis();
    redState = !redState;
    digitalWrite(LED_RED, redState);
  }

  // Hijau nyala saat conveyor aktif
  digitalWrite(LED_GREEN, conveyor_on ? HIGH : LOW);
}

void indicateStatus() {
  // LED indicator berdasarkan status sistem
  if (!serverConnected && WiFi.status() != WL_CONNECTED) {
    // Merah berkedip cepat - WiFi terputus
    if (millis() % 500 < 250) {
      digitalWrite(LED_RED, HIGH);
    } else {
      digitalWrite(LED_RED, LOW);
    }
  } else if (!serverConnected) {
    // Merah berkedip normal - server tidak reachable
    if (millis() % 1000 < 500) {
      digitalWrite(LED_RED, HIGH);
    } else {
      digitalWrite(LED_RED, LOW);
    }
  } else {
    // Merah nyala stabil - semua OK
    digitalWrite(LED_RED, HIGH);
  }

  // Hijau nyala saat conveyor aktif
  digitalWrite(LED_GREEN, conveyor_on ? HIGH : LOW);
}


/* ========= SEND DATA ========= */
void sendData() {
  Time t = rtc.time();

  Serial.println("\n=== SMART RIVER ===");
  Serial.print("BERAT: "); Serial.println(berat);
  Serial.print("LDR: "); Serial.println(ldr);
  Serial.print("TILT: "); Serial.println(tilt);
  Serial.print("VOLT: "); Serial.println(volt);

  if (gps.location.isValid()) {
    Serial.print("GPS: ");
    Serial.print(gps.location.lat(), 6);
    Serial.print(",");
    Serial.println(gps.location.lng(), 6);
  } else {
    Serial.println("GPS: belum fix");
  }

  Serial.print("TIME: ");
  Serial.print(t.date); Serial.print("/");
  Serial.print(t.mon); Serial.print("/");
  Serial.print(t.yr); Serial.print(" ");
  Serial.print(t.hr); Serial.print(":");
  Serial.print(t.min); Serial.print(":");
  Serial.println(t.sec);

  // Kirim ke Raspberry Pi via Serial2
  Serial2.print("{");
  Serial2.print("\"berat\":"); Serial2.print(berat); Serial2.print(",");
  Serial2.print("\"ldr\":"); Serial2.print(ldr); Serial2.print(",");
  Serial2.print("\"tilt\":"); Serial2.print(tilt); Serial2.print(",");
  Serial2.print("\"volt\":"); Serial2.print(volt); Serial2.print(",");
  Serial2.print("\"conveyor\":"); Serial2.print(conveyor_on ? "true" : "false");

  if (gps.location.isValid()) {
    Serial2.print(",\"lat\":");
    Serial2.print(gps.location.lat(), 6);
    Serial2.print(",\"lng\":");
    Serial2.print(gps.location.lng(), 6);
  }

  Serial2.println("}");
}


/* ========= HOME LOGIC ========= */
void checkHome() {
  if (berat >= 5000 && millis() - lastHome > 10000) {
    Serial.println("STATUS HOME");
    Serial2.println("HOME");
    beep(2);
    lastHome = millis();
  }
}


/* ========= MOTOR ========= */
void motorControl() {
  digitalWrite(CONVEYOR_ULN_PIN, conveyor_on ? HIGH : LOW);
}

void stopMotor() {
  conveyor_on = false;
  digitalWrite(CONVEYOR_ULN_PIN, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
}

/* ========= BUZZER ========= */
void beep(int x) {
  for (int i = 0; i < x; i++) {
    digitalWrite(BUZZER_PIN, HIGH);
    delay(150);
    digitalWrite(BUZZER_PIN, LOW);
    delay(150);
  }
}


/* ========= WIFI ========= */
void connectWiFi() {
  // Cek apakah sudah terhubung
  if (WiFi.status() == WL_CONNECTED) {
    return;
  }
  
  Serial.println("Menghubungkan ke WiFi...");
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);
  
  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 20) {
    delay(500);
    Serial.print(".");
    attempts++;
  }
  
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nWiFi Terhubung!");
    Serial.print("IP Address: ");
    Serial.println(WiFi.localIP());
    serverConnected = true;
  } else {
    Serial.println("\nGagal terhubung ke WiFi!");
    WiFi.disconnect();
    serverConnected = false;
  }
}

void checkWiFiConnection() {
  if (WiFi.status() != WL_CONNECTED) {
    // Retry koneksi WiFi jika interval sudah terpenuhi
    if (millis() - lastWiFiRetry > WIFI_RETRY_DELAY) {
      lastWiFiRetry = millis();
      Serial.println("WiFi terputus, mencoba reconnect...");
      connectWiFi();
    }
  }
}


/* ========= SERVER COMMUNICATION ========= */
void sendToServer() {
  // Cek koneksi WiFi dulu
  checkWiFiConnection();
  
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi tidak terhubung");
    serverConnected = false;
    return;
  }
  
  HTTPClient http;
  
  // Kirim data sensor ke server
  String url = String(serverUrl) + "/update-device";
  http.begin(url);
  http.addHeader("Content-Type", "application/json");
  http.setTimeout(HTTP_TIMEOUT);
  
  // Buat JSON payload
  String jsonData = "{";
  jsonData += "\"name\":\"Smart River 1\",";
  jsonData += "\"status\":\"";
  jsonData += (berat > 0) ? "ONLINE" : "ERROR";
  jsonData += "\"";
  jsonData += "}";
  
  int httpCode = http.POST(jsonData);
  
  if (httpCode == 200) {
    String response = http.getString();
    Serial.println("Server response: " + response);
    serverConnected = true;
    lastServerRetry = millis();  // Reset retry timer jika berhasil
  } else {
    Serial.println("Gagal mengirim ke server: " + String(httpCode));
    serverConnected = false;
    
    // Retry jika gagal
    if (millis() - lastServerRetry > SERVER_RETRY_DELAY) {
      lastServerRetry = millis();
      Serial.println("Mencoba ulang koneksi server...");
    }
  }
  
  http.end();
}

void checkServerControl() {
  // Cek koneksi WiFi dulu
  checkWiFiConnection();
  
  if (WiFi.status() != WL_CONNECTED) {
    return;
  }
  
  HTTPClient http;
  
  // Cek status kontrol dari server
  String url = String(serverUrl) + "/api/devices";
  http.begin(url);
  http.setTimeout(HTTP_TIMEOUT);
  
  int httpCode = http.GET();
  
  if (httpCode == 200) {
    String response = http.getString();
    Serial.println("Control status: " + response);
    
    // Parse response untuk cek control_active
    // Jika control_active = true, nyalakan conveyor
    if (response.indexOf("\"control_active\":true") >= 0 || response.indexOf("\"control_active\": true") >= 0) {
      if (!conveyor_on) {
        setConveyor(true, "server");
        beep(2);
      }
    }
  } else {
    Serial.println("Gagal cek control: " + String(httpCode));
  }
  
  http.end();
}

